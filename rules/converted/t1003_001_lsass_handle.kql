// generated by scripts/convert_rules.py, do not edit
// source: rules/t1003_001_lsass_handle.yml
// backend: kusto, pipelines: sysmon + windows-logsources
Channel =~ "Microsoft-Windows-Sysmon/Operational" and (EventID == 10 and ((TargetImage endswith "\\lsass.exe" and (GrantedAccess in~ ("0x1010", "0x1410", "0x1f3fff", "0x1fffff", "0x1038", "0x1418", "0x1438", "0x143a", "0x1f0fff", "0x1f1fff", "0x1f2fff", "0x101010", "0x141010"))) and (not(((SourceImage endswith ":\\Windows\\System32\\wininit.exe" or SourceImage endswith ":\\Windows\\System32\\csrss.exe" or SourceImage endswith ":\\Windows\\System32\\services.exe" or SourceImage endswith ":\\Windows\\System32\\lsass.exe") or SourceImage endswith ":\\Windows\\System32\\wbem\\WmiPrvSE.exe" or SourceImage endswith ":\\Windows\\System32\\wsmprovhost.exe" or (SourceImage contains ":\\ProgramData\\Microsoft\\Windows Defender\\" and SourceImage endswith "\\MsMpEng.exe"))))))
