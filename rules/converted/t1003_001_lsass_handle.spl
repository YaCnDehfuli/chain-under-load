Channel="Microsoft-Windows-Sysmon/Operational" EventID=10 TargetImage="*\\lsass.exe" GrantedAccess IN ("0x1010", "0x1410", "0x1f3fff", "0x1fffff", "0x1038", "0x1418", "0x1438", "0x143a", "0x1f0fff", "0x1f1fff", "0x1f2fff", "0x101010", "0x141010") NOT (SourceImage IN ("*:\\Windows\\System32\\wininit.exe", "*:\\Windows\\System32\\csrss.exe", "*:\\Windows\\System32\\services.exe", "*:\\Windows\\System32\\lsass.exe") OR SourceImage="*:\\Windows\\System32\\wbem\\WmiPrvSE.exe" OR SourceImage="*:\\Windows\\System32\\wsmprovhost.exe" OR (SourceImage="*:\\ProgramData\\Microsoft\\Windows Defender\\*" SourceImage="*\\MsMpEng.exe"))
